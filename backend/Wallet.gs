/** Wallet v1. Extends the existing project/Sheet. Money is integer EUR cents.
 * Client claims never establish proof of gameplay, revenue or payment.
 * Install after renaming the existing route_ to preWalletRoute_. */
const WALLET_SCHEMA={
 COIN_LEDGER:['transaction_id','user_id','timestamp','source','game_id','session_id','coins','status','verification_reason','revenue_reference','created_at','verified_at','entry_type','parent_id','event_key','period_id'],
 REWARD_SESSIONS:['session_id','user_id','game_id','started_at','expires_at'],
 REVENUE_POOLS:['period_id','start_date','end_date','gross_confirmed_revenue','platform_share','player_reward_pool','verified_coins_for_period','cash_per_verified_coin','status','approved_at','revenue_reference','funding_reference','snapshot_at','snapshot_hash','actor','created_at','partner_approval_reference','funded_amount'],
 CONVERSIONS:['conversion_id','period_id','user_id','eligible_coins','amount_cents','rate_numerator_cents','rate_denominator_coins','snapshot_hash','created_at'],
 CASHOUT_REQUESTS:['cashout_id','user_id','amount','currency','payment_method','payment_destination','requested_at','status','review_note','approved_at','paid_at','payment_reference','event_id','idempotency_key','created_at'],
 AUDIT_LOG:['event_id','action','admin','user','old_value','new_value','reason','timestamp','previous_hash','hash']
};
function walletInitSchema_(){Object.assign(SCHEMA,WALLET_SCHEMA);}
const WALLET_ACTIONS=['getWalletProfile','getBalance','startRewardSession','recordRewardEvent','getCoinHistory','getCashoutEligibility','requestCashout','getCashoutHistory','cancelCashout','getTransactionHistory'];
const CASH_MIN_CENTS=500;
function setupWallet(){
 const active=Session.getActiveUser().getEmail();if(!active||active!==Session.getEffectiveUser().getEmail())fail_("FORBIDDEN","Run setup from the owner editor");
 walletInitSchema_();
 // db_ fails if the existing database is absent; never creates a new database.
 const lock=LockService.getScriptLock();lock.waitLock(30000);
 try{const db=db_();Object.keys(WALLET_SCHEMA).forEach(name=>{let sheet=db.getSheetByName(name);if(!sheet)sheet=db.insertSheet(name);
 const headers=WALLET_SCHEMA[name];if(sheet.getLastRow()===0){sheet.getRange(1,1,1,headers.length).setValues([headers]);sheet.setFrozenRows(1);sheet.getRange(1,1,1,headers.length).setBackground('#101d42').setFontColor('#ffd36c').setFontWeight('bold');sheet.setColumnWidths(1,headers.length,160);}else if(JSON.stringify(sheet.getRange(1,1,1,headers.length).getValues()[0])!==JSON.stringify(headers))throw Error('WALLET_SCHEMA_MISMATCH '+name);});SpreadsheetApp.flush();console.log('WALLET_READY existing database; no funds or rewards seeded');}finally{lock.releaseLock();}
}
function walletLock_(fn){const lock=LockService.getScriptLock();lock.waitLock(30000);try{return fn();}finally{lock.releaseLock();}}
function walletRows_(name){walletInitSchema_();if(!db_().getSheetByName(name))fail_('WALLET_NOT_READY','Wallet setup has not been completed');return rows_(name).map(r=>{const o=Object.assign({},r);Object.keys(o).forEach(k=>{if(o[k] instanceof Date)o[k]=o[k].toISOString();});return o;});}
function walletSafeInt_(v,min=0,max=1000000000000){if(typeof v!=='number'||!Number.isSafeInteger(v)||v<min||v>max)fail_('INVALID_AMOUNT','Invalid integer value');return v;}
function walletMoney_(text){if(typeof text!=='string'||!(/^(0|[1-9][0-9]{0,9})(\.[0-9]{1,2})?$/).test(text))fail_('INVALID_AMOUNT','Enter a valid EUR amount with at most two decimals');const a=text.split('.');return walletSafeInt_(Number(BigInt(a[0])*BigInt(100)+BigInt(((a[1]||'')+'00').slice(0,2))),0,100000000000);}
function walletText_(v,min=1,max=200){if(typeof v!=='string'||v.trim().length<min||v.trim().length>max)fail_('INVALID_REQUEST','Invalid text field');return v.trim();}
function walletId_(v){const x=walletText_(v,8,120);if(!/^[A-Za-z0-9_:-]+$/.test(x))fail_('INVALID_REQUEST','Invalid request identifier');return x;}
function walletLatest_(rows,key){const m=Object.create(null);rows.forEach(r=>m[r[key]]=r);return Object.keys(m).map(k=>m[k]);}
function walletAudit_(action,actor,user,oldValue,newValue,reason){const rows=walletRows_('AUDIT_LOG'),previous=rows.length?String(rows[rows.length-1].hash):'';const a={event_id:uid_(),action,admin:actor,user:user||'',old_value:JSON.stringify(oldValue),new_value:JSON.stringify(newValue),reason:walletText_(reason,3,500),timestamp:iso_(),previous_hash:previous};a.hash=digest_(JSON.stringify(a));write_('AUDIT_LOG',a);return a.event_id;}
function walletAuditVerified_(){const entries=walletRows_('AUDIT_LOG');let previous='';entries.forEach(r=>{const a={event_id:r.event_id,action:r.action,admin:r.admin,user:r.user,old_value:r.old_value,new_value:r.new_value,reason:r.reason,timestamp:r.timestamp,previous_hash:r.previous_hash};if(r.previous_hash!==previous||r.hash!==digest_(JSON.stringify(a)))fail_('AUDIT_REVIEW','Audit integrity needs administrative review');previous=r.hash;});return entries;}
function walletAudited_(name,rows){const audit=walletAuditVerified_(),columns=WALLET_SCHEMA[name];rows.forEach(row=>{const actual=JSON.stringify(columns.map(k=>row[k]===undefined?'':row[k]));const found=audit.some(a=>{try{const x=JSON.parse(a.new_value);return x&&typeof x==='object'&&JSON.stringify(columns.map(k=>x[k]===undefined?'':x[k]))===actual;}catch(_){return false;}});if(!found)fail_('AUDIT_REVIEW','Ledger row has no matching audited transaction');});return rows;}
function walletAdmin_(){const active=Session.getActiveUser().getEmail(),effective=Session.getEffectiveUser().getEmail(),configured=PropertiesService.getScriptProperties().getProperty('WALLET_ADMIN_EMAIL');if(!active||active!==effective||active!==configured)fail_('FORBIDDEN','Owner editor authorization is required');return active;}
function configureWalletAdmin(){const a=Session.getActiveUser().getEmail(),e=Session.getEffectiveUser().getEmail();if(!a||a!==e)fail_('FORBIDDEN','Run from the owner Apps Script editor');PropertiesService.getScriptProperties().setProperty('WALLET_ADMIN_EMAIL',a);console.log('Wallet administration configured for the current owner');}
function walletCoins_(user){const all=walletAudited_('COIN_LEDGER',walletRows_('COIN_LEDGER')),earn=all.filter(x=>x.user_id===user&&['EARN','ADMIN_ADJUSTMENT'].includes(x.entry_type));return earn.map(e=>{const decisions=all.filter(x=>x.user_id===user&&x.parent_id===e.transaction_id);return Object.assign({},e,decisions.length?{status:decisions[decisions.length-1].status,verification_reason:decisions[decisions.length-1].verification_reason,revenue_reference:decisions[decisions.length-1].revenue_reference,verified_at:decisions[decisions.length-1].verified_at}:{});});}
function walletPool_(id){return walletLatest_(walletAudited_('REVENUE_POOLS',walletRows_('REVENUE_POOLS')),'period_id').find(p=>p.period_id===id);}
function walletCashouts_(user){return walletLatest_(walletAudited_('CASHOUT_REQUESTS',walletRows_('CASHOUT_REQUESTS').filter(x=>x.user_id===user)),'cashout_id');}
function walletBalance_(user){
 const coins=walletCoins_(user),pools=walletLatest_(walletAudited_('REVENUE_POOLS',walletRows_('REVENUE_POOLS')),'period_id'),conversions=walletAudited_('CONVERSIONS',walletRows_('CONVERSIONS').filter(c=>c.user_id===user)),valid=pools.filter(p=>['APPROVED','CLOSED'].includes(p.status));
 let earned=0;const unique=new Set();conversions.forEach(c=>{const pool=valid.find(p=>p.period_id===c.period_id&&p.snapshot_hash===c.snapshot_hash);if(pool&&!unique.has(c.conversion_id)){earned+=walletSafeInt_(Number(c.amount_cents));unique.add(c.conversion_id);}});
 const out=walletCashouts_(user);let reserved=0,paid=0;out.forEach(c=>{if(['REQUESTED','UNDER_REVIEW','APPROVED'].includes(c.status))reserved+=walletSafeInt_(Number(c.amount));if(c.status==='PAID')paid+=walletSafeInt_(Number(c.amount));});
 const pending=coins.filter(c=>c.status==='PENDING').reduce((s,c)=>s+Number(c.coins),0),verified=coins.filter(c=>c.status==='VERIFIED').reduce((s,c)=>s+Number(c.coins),0);
 if(earned-paid-reserved<0)fail_('WALLET_REVIEW','Balance needs administrative review');return {currency:'EUR',pending_coins:pending,verified_coins:verified,available_cents:earned-paid-reserved,total_earned_cents:earned,total_paid_cents:paid,pending_cashout_cents:reserved,minimum_cashout_cents:CASH_MIN_CENTS,cashout_allowed:earned-paid-reserved>=CASH_MIN_CENTS,revenue_funded:valid.some(p=>Number(p.player_reward_pool)>0)};
}
function walletPublicOut_(c){return {cashout_id:c.cashout_id,requested_at:c.requested_at,amount_cents:Number(c.amount),currency:c.currency,payment_method:c.payment_method,status:c.status,payment_reference:c.payment_reference||'',review_note:c.review_note||'',paid_at:c.paid_at||''};}
function route_(p){
 if(!WALLET_ACTIONS.includes(p.action))return preWalletRoute_(p);
 return walletLock_(()=>{const identity=auth_(p),u=identity.u;
 if(p.user_id!==undefined||p.balance!==undefined||p.coins!==undefined||p.status!==undefined||p.verified!==undefined)fail_('CLIENT_AUTHORITY','The server determines identity, coins and balances');
 if(p.action==='getBalance')return Object.assign({success:true},walletBalance_(u.user_id));
 if(p.action==='getWalletProfile')return {success:true,profile:{username:u.name,email:u.email,user_id:u.user_id,joined_date:u.created_at},balance:walletBalance_(u.user_id)};
 if(p.action==='getCashoutEligibility'){const b=walletBalance_(u.user_id);return {success:true,eligible:b.cashout_allowed,balance:b,message:b.cashout_allowed?'Verified cash is available for manual review.':'Minimum cash out is €5.00'};}
 if(p.action==='getTransactionHistory'){const records=walletRows_('WALLET_LEDGER').filter(x=>x.user_id===u.user_id).reverse(),offset=walletSafeInt_(p.offset===undefined?0:p.offset,0,1000000);return {success:true,total:records.length,transactions:records.slice(offset,offset+50).map(x=>({transaction_id:x.transaction_id,timestamp:x.created_at,event_type:x.event_type,amount_cents:Number(x.amount),currency:'EUR',source:x.source,status:x.status}))};}
 if(p.action==='getCoinHistory'){const all=walletCoins_(u.user_id).reverse(),offset=walletSafeInt_(p.offset===undefined?0:p.offset,0,1000000);return {success:true,total:all.length,transactions:all.slice(offset,offset+50).map(c=>({transaction_id:c.transaction_id,timestamp:c.timestamp,source:c.source,game_id:c.game_id,coins:Number(c.coins),status:c.status,verification_reason:c.verification_reason,period_id:c.period_id}))};}
 if(p.action==='getCashoutHistory'){const all=walletCashouts_(u.user_id).reverse(),offset=walletSafeInt_(p.offset===undefined?0:p.offset,0,1000000);return {success:true,total:all.length,cashouts:all.slice(offset,offset+50).map(walletPublicOut_)};}
 if(p.action==='startRewardSession'){const game=walletText_(p.game_id,1,100);if(!/^[A-Za-z0-9 _-]+$/.test(game))fail_('INVALID_GAME','Invalid game');const previous=walletRows_('REWARD_SESSIONS').filter(s=>s.user_id===u.user_id&&Date.now()-Date.parse(s.started_at)<60000);if(previous.length>=3)fail_('RATE_LIMIT','Wait before starting another reward session');const now=iso_(),s={session_id:uid_(),user_id:u.user_id,game_id:game,started_at:now,expires_at:new Date(Date.now()+7200000).toISOString()};write_('REWARD_SESSIONS',s);return {success:true,session_id:s.session_id,started_at:now,expires_at:s.expires_at,ad_reward_coins:game.startsWith('html5_')?walletVideoCoins_():0};}
 if(p.action==='recordRewardEvent')return walletReward_(u,p);
 if(p.action==='requestCashout')return walletRequestOut_(u,p);
 if(p.action==='cancelCashout'){const c=walletCashouts_(u.user_id).find(c=>c.cashout_id===p.cashout_id);if(!c)fail_('NOT_FOUND','Cash out not found');if(c.status==='CANCELLED')return {success:true,cashout:walletPublicOut_(c)};if(c.status!=='REQUESTED')fail_('INVALID_STATE','Only an unreviewed request can be cancelled');const next=Object.assign({},c,{event_id:uid_(),status:'CANCELLED',created_at:iso_()});walletAudit_('CANCEL_CASHOUT',u.user_id,u.user_id,c,next,'User cancelled before review');write_('CASHOUT_REQUESTS',next);return {success:true,cashout:walletPublicOut_(next),balance:walletBalance_(u.user_id)};}
 fail_('INVALID_ACTION','Unsupported action');});
}
function walletVideoCoins_(){const raw=PropertiesService.getScriptProperties().getProperty('WALLET_HTML5_VIDEO_COINS');if(raw==null||raw==='')return 10;const n=Number(raw);if(!Number.isSafeInteger(n)||n<0||n>1000)fail_('REWARD_CONFIG','Video coin rule requires owner review');return n;}
function walletReward_(u,p){
 const source=walletText_(p.source),eventId=walletId_(p.event_id),sessionId=walletId_(p.session_id),game=walletText_(p.game_id,1,100);if(!['GAME','LEVEL','ACHIEVEMENT','AD_REWARD','GAMEPIX','BONUS'].includes(source))fail_('INVALID_SOURCE','Unsupported reward source');
 const session=walletRows_('REWARD_SESSIONS').find(s=>s.session_id===sessionId&&s.user_id===u.user_id&&s.game_id===game);if(!session||Date.parse(session.expires_at)<=Date.now())fail_('INVALID_SESSION','Start a new reward session');
 const ledger=walletRows_('COIN_LEDGER'),own=ledger.filter(r=>r.user_id===u.user_id&&['EARN','ADMIN_ADJUSTMENT'].includes(r.entry_type)),key=source==='LEVEL'?game+':LEVEL:'+walletSafeInt_(p.level,1,100000):source==='ACHIEVEMENT'?game+':ACHIEVEMENT:'+walletId_(p.achievement_id):source==='GAME'?game+':GAME:'+sessionId:'EVENT:'+eventId;
 const duplicate=own.find(r=>r.transaction_id==='evt:'+u.user_id+':'+eventId||r.event_key===key);if(duplicate)return {success:true,duplicate:true,transaction_id:duplicate.transaction_id,status:duplicate.status,coins:Number(duplicate.coins)};
 let status='PENDING',reason='Client gameplay claim; awaiting independent verification';const now=Date.now(),recent=own.filter(r=>now-Date.parse(r.created_at)<60000);
 if(recent.length>=20)fail_('RATE_LIMIT','Too many reward events');
 if(now-Date.parse(session.started_at)<10000){status='REJECTED';reason='Impossible gameplay interval';}
 if(p.timestamp!==undefined&&(!Number.isFinite(Date.parse(p.timestamp))||Math.abs(now-Date.parse(p.timestamp))>300000)){status='REJECTED';reason='Client timestamp outside allowed interval';}
 const last=own.filter(r=>r.session_id===sessionId).slice(-1)[0];if(last&&now-Date.parse(last.created_at)<5000){status='REJECTED';reason='Reward events submitted too quickly';}
 const amount={GAME:1,LEVEL:10,ACHIEVEMENT:25,AD_REWARD:game.startsWith('html5_')?walletVideoCoins_():0,GAMEPIX:0,BONUS:0}[source];
 if(['AD_REWARD','GAMEPIX','BONUS'].includes(source)&&status!=='REJECTED')reason='No verified partner callback or funded bonus reference; no cash value';
 const row={transaction_id:'evt:'+u.user_id+':'+eventId,user_id:u.user_id,timestamp:iso_(),source,game_id:game,session_id:sessionId,coins:amount,status,verification_reason:reason,revenue_reference:'',created_at:iso_(),verified_at:'',entry_type:'EARN',parent_id:'',event_key:key,period_id:new Date().toISOString().slice(0,7)};
 walletAudit_('REWARD_EVENT',u.user_id,u.user_id,null,row,reason);write_('COIN_LEDGER',row);return {success:true,transaction_id:row.transaction_id,status,coins:amount,balance:walletBalance_(u.user_id)};
}
function walletRequestOut_(u,p){
 const key=walletId_(p.idempotency_key),all=walletCashouts_(u.user_id),old=all.find(c=>c.idempotency_key===key);if(old){if(Number(old.amount)!==walletMoney_(p.amount)||old.payment_destination!==email_(p.payment_destination)||old.payment_method!==p.payment_method)fail_('IDEMPOTENCY_CONFLICT','This request identifier was already used with different details');return {success:true,duplicate:true,cashout:walletPublicOut_(old),balance:walletBalance_(u.user_id)};}
 const amount=walletMoney_(p.amount),destination=email_(p.payment_destination);if(p.payment_method!=='PAYPAL')fail_('INVALID_METHOD','Only a user-supplied PayPal email is supported');const b=walletBalance_(u.user_id);if(amount<CASH_MIN_CENTS||amount>b.available_cents)fail_('INSUFFICIENT_CASH','Minimum cash out is €5.00 and only verified available cash can be used');
 const now=iso_(),c={cashout_id:uid_(),user_id:u.user_id,amount,currency:'EUR',payment_method:'PAYPAL',payment_destination:destination,requested_at:now,status:'REQUESTED',review_note:'',approved_at:'',paid_at:'',payment_reference:'',event_id:uid_(),idempotency_key:key,created_at:now};
 // One immutable row is both request and reservation. Script lock prevents double spend.
 walletAudit_('REQUEST_CASHOUT',u.user_id,u.user_id,{available_cents:b.available_cents},c,'User requested manual verified payout');write_('CASHOUT_REQUESTS',c);return {success:true,message:'Cash out request submitted for verification.',cashout:walletPublicOut_(c),balance:walletBalance_(u.user_id)};
}
// Privileged operations are owner-editor functions, never public HTTP actions.
function walletReviewCoins_(transactionId,decision,reference,reason){const actor=walletAdmin_();return walletLock_(()=>{
 if(!['VERIFIED','REJECTED'].includes(decision))fail_('INVALID_STATE','Invalid decision');reference=walletText_(reference,5,200);reason=walletText_(reason,5,500);const base=walletRows_('COIN_LEDGER').find(c=>c.transaction_id===transactionId&&['EARN','ADMIN_ADJUSTMENT'].includes(c.entry_type));if(!base)fail_('NOT_FOUND','Coin transaction not found');const current=walletCoins_(base.user_id).find(c=>c.transaction_id===transactionId);if(current.status===decision)return current;if(current.status!=='PENDING')fail_('INVALID_STATE','A final coin decision cannot be edited');
 const row=Object.assign({},base,{transaction_id:uid_(),parent_id:base.transaction_id,entry_type:'DECISION',status:decision,verification_reason:reason,revenue_reference:reference,verified_at:decision==='VERIFIED'?iso_():'',created_at:iso_()});walletAudit_('REVIEW_COINS',actor,base.user_id,current,row,reason);write_('COIN_LEDGER',row);return row;});}
function walletCreatePool_(p){const actor=walletAdmin_();return walletLock_(()=>{const id=walletId_(p.period_id);if(walletPool_(id))fail_('DUPLICATE_PERIOD','Period already exists');const start=new Date(p.start_date).toISOString(),end=new Date(p.end_date).toISOString();if(start>=end||end>iso_())fail_('INVALID_PERIOD','Only a completed period may be funded');const existing=walletLatest_(walletRows_('REVENUE_POOLS'),'period_id');if(existing.some(x=>start<x.end_date&&end>x.start_date))fail_('OVERLAPPING_PERIOD','Revenue periods may not overlap');const gross=walletMoney_(p.gross_confirmed_revenue),reward=walletMoney_(p.player_reward_pool),funded=walletMoney_(p.funded_amount);if(reward>gross||reward>funded||reward===0)fail_('UNFUNDED_POOL','Pool must be confirmed and fully funded');const partnerApproval=walletText_(p.partner_approval_reference,5,200);const ref=walletText_(p.revenue_reference,5,200),funding=walletText_(p.funding_reference,5,200);if(existing.some(x=>x.revenue_reference===ref||x.funding_reference===funding))fail_('DUPLICATE_REVENUE','Revenue/funding reference already used');const pool={period_id:id,start_date:start,end_date:end,gross_confirmed_revenue:gross,platform_share:gross-reward,player_reward_pool:reward,verified_coins_for_period:0,cash_per_verified_coin:'',status:'OPEN',approved_at:'',revenue_reference:ref,funding_reference:funding,snapshot_at:'',snapshot_hash:'',actor,created_at:iso_(),partner_approval_reference:partnerApproval,funded_amount:funded};walletAudit_('CREATE_REVENUE_POOL',actor,'',null,pool,'Owner attested confirmed revenue, partner approval and funding');write_('REVENUE_POOLS',pool);return pool;});}
function walletEligible_(pool){const rows=walletRows_('COIN_LEDGER'),users=[...new Set(rows.map(r=>r.user_id))],snapshot=pool.snapshot_at||iso_();let eligible=[];users.forEach(user=>walletCoins_(user).filter(c=>c.status==='VERIFIED'&&c.timestamp>=pool.start_date&&c.timestamp<pool.end_date&&c.verified_at<=snapshot&&Number(c.coins)>0).forEach(c=>eligible.push(c)));return eligible.sort((a,b)=>a.transaction_id.localeCompare(b.transaction_id));}
function walletAllocate_(coinRows,poolCents){const totals=Object.create(null);coinRows.forEach(c=>totals[c.user_id]=(totals[c.user_id]||0)+Number(c.coins));const total=Object.values(totals).reduce((s,n)=>s+n,0);if(!total)fail_('NO_ELIGIBLE_COINS','No verified coins in period');const denominator=BigInt(total),numerator=BigInt(poolCents),users=Object.keys(totals).sort().map(user=>{const product=BigInt(totals[user])*numerator;return {user_id:user,coins:totals[user],cents:Number(product/denominator),remainder:product%denominator};});let left=poolCents-users.reduce((s,u)=>s+u.cents,0);users.sort((a,b)=>a.remainder===b.remainder?a.user_id.localeCompare(b.user_id):a.remainder>b.remainder?-1:1);for(let i=0;i<left;i++)users[i].cents++;return {total,users};}
function walletCalculatePool_(id){const actor=walletAdmin_();return walletLock_(()=>{const pool=walletPool_(id);if(!pool)fail_('NOT_FOUND','Period not found');if(pool.status==='CALCULATED')return pool;if(pool.status!=='OPEN')fail_('INVALID_STATE','Period cannot be calculated');pool.snapshot_at=iso_();const eligible=walletEligible_(pool),allocation=walletAllocate_(eligible,Number(pool.player_reward_pool));pool.snapshot_hash=digest_(JSON.stringify(eligible.map(c=>[c.transaction_id,c.user_id,Number(c.coins)])));pool.verified_coins_for_period=allocation.total;pool.cash_per_verified_coin=String(pool.player_reward_pool)+'/'+String(allocation.total)+' cents';pool.status='CALCULATED';pool.created_at=iso_();pool.actor=actor;walletAudit_('CALCULATE_POOL',actor,'',null,pool,'Freeze eligible coins and rational conversion rate');write_('REVENUE_POOLS',pool);return pool;});}
function walletApprovePool_(id){const actor=walletAdmin_();return walletLock_(()=>{const pool=walletPool_(id);if(!pool)fail_('NOT_FOUND','Period not found');if(pool.status==='APPROVED')return pool;if(pool.status!=='CALCULATED')fail_('INVALID_STATE','Calculate funded pool first');const eligible=walletEligible_(pool),hash=digest_(JSON.stringify(eligible.map(c=>[c.transaction_id,c.user_id,Number(c.coins)])));if(hash!==pool.snapshot_hash)fail_('SNAPSHOT_CHANGED','Frozen eligibility changed; administrative review required');const allocation=walletAllocate_(eligible,Number(pool.player_reward_pool)),existing=walletRows_('CONVERSIONS');allocation.users.forEach(u=>{const conversionId='conversion:'+id+':'+u.user_id,old=existing.find(x=>x.conversion_id===conversionId);if(old){if(Number(old.amount_cents)!==u.cents||old.snapshot_hash!==hash)fail_('CONVERSION_CONFLICT','Conversion differs from frozen snapshot');return;}const c={conversion_id:conversionId,period_id:id,user_id:u.user_id,eligible_coins:u.coins,amount_cents:u.cents,rate_numerator_cents:Number(pool.player_reward_pool),rate_denominator_coins:allocation.total,snapshot_hash:hash,created_at:iso_()};walletAudit_('CONVERT_VERIFIED_COINS',actor,u.user_id,null,c,'Funded revenue allocation; not spendable before pool approval');write_('CONVERSIONS',c);write_('WALLET_LEDGER',{transaction_id:conversionId,user_id:u.user_id,event_type:'CONVERSION',amount:u.cents,source:'REVENUE_POOL',ad_event_id:'',created_at:iso_(),status:'VERIFIED',metadata_json:JSON.stringify({period_id:id,snapshot_hash:hash,currency:'EUR'})});});
 pool.status='APPROVED';pool.approved_at=iso_();pool.created_at=iso_();pool.actor=actor;walletAudit_('APPROVE_POOL',actor,'','CALCULATED',pool,'Owner approved confirmed and funded reward pool');write_('REVENUE_POOLS',pool);return pool;});}
function walletReviewCashout_(id,status,reference,reason){const actor=walletAdmin_();return walletLock_(()=>{const all=walletLatest_(walletRows_('CASHOUT_REQUESTS'),'cashout_id'),c=all.find(c=>c.cashout_id===id);if(!c)fail_('NOT_FOUND','Cash out not found');if(c.status===status)return walletPublicOut_(c);const transitions={REQUESTED:['UNDER_REVIEW','REJECTED'],UNDER_REVIEW:['APPROVED','REJECTED'],APPROVED:['PAID','REJECTED']};if(!(transitions[c.status]||[]).includes(status))fail_('INVALID_STATE','Invalid cash out transition');reason=walletText_(reason,5,500);if(status==='PAID'){reference=walletText_(reference,5,200);if(all.some(x=>x.status==='PAID'&&x.payment_reference===reference))fail_('DUPLICATE_PAYMENT','Payment reference already recorded');}const next=Object.assign({},c,{status,event_id:uid_(),review_note:reason,approved_at:status==='APPROVED'?iso_():c.approved_at,paid_at:status==='PAID'?iso_():'',payment_reference:status==='PAID'?reference:'',created_at:iso_()});walletAudit_('CASHOUT_'+status,actor,c.user_id,c,next,reason);write_('CASHOUT_REQUESTS',next);return walletPublicOut_(next);});}
function walletAdjustCoins_(user,coins,reference,reason){const actor=walletAdmin_();return walletLock_(()=>{walletSafeInt_(coins,1,1000000);if(!rows_('USERS').some(u=>u.user_id===user&&u.status==='ACTIVE'))fail_('NOT_FOUND','User not found');reference=walletText_(reference,5,200);if(walletRows_('COIN_LEDGER').some(c=>c.source==='ADMIN_ADJUSTMENT'&&c.revenue_reference===reference))fail_('DUPLICATE_ADJUSTMENT','Adjustment reference already used');const now=iso_(),row={transaction_id:uid_(),user_id:user,timestamp:now,source:'ADMIN_ADJUSTMENT',game_id:'ADMIN',session_id:'',coins,status:'PENDING',verification_reason:walletText_(reason,5,500),revenue_reference:reference,created_at:now,verified_at:'',entry_type:'ADMIN_ADJUSTMENT',parent_id:'',event_key:reference,period_id:now.slice(0,7)};walletAudit_('ADMIN_ADJUSTMENT',actor,user,null,row,reason);write_('COIN_LEDGER',row);return row;});}

function walletClosePool_(id){const actor=walletAdmin_();return walletLock_(()=>{const pool=walletPool_(id);if(!pool||pool.status!=='APPROVED')fail_('INVALID_STATE','Only approved pools can close');const next=Object.assign({},pool,{status:'CLOSED',actor,created_at:iso_()});walletAudit_('CLOSE_POOL',actor,'',pool,next,'Close funded period without changing its conversion snapshot');write_('REVENUE_POOLS',next);return next;});}

