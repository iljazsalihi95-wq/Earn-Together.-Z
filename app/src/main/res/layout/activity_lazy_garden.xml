<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="10dp" android:background="#081421">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/lazygarden_panel" android:padding="12dp">
  <TextView android:id="@+id/lgTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/lg_title" android:textColor="#F6E4A8" android:textSize="24sp" android:textStyle="bold"/>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="6dp">
   <TextView android:id="@+id/lgLevel" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="#FFFFFF" android:textSize="14sp"/>
   <TextView android:id="@+id/lgMoves" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textColor="#FFFFFF" android:textSize="14sp"/>
   <TextView android:id="@+id/lgCoins" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:textColor="#F6D36F" android:textSize="14sp" android:textStyle="bold"/>
  </LinearLayout>
 </LinearLayout>
 <FrameLayout android:id="@+id/lgSceneHost" android:layout_width="match_parent" android:layout_height="150dp" android:layout_marginTop="6dp" android:background="@drawable/lazygarden_board"/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/lazygarden_panel" android:padding="8dp">
  <TextView android:id="@+id/lgAvatar" android:layout_width="42dp" android:layout_height="42dp" android:gravity="center" android:text="A" android:textColor="#081421" android:textSize="20sp" android:textStyle="bold" android:background="#F6D36F"/>
  <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:orientation="vertical">
   <TextView android:id="@+id/lgSpeaker" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#F6D36F" android:textStyle="bold" android:textSize="14sp"/>
   <TextView android:id="@+id/lgDialogue" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="#FFFFFF" android:textSize="13sp"/>
  </LinearLayout>
 </LinearLayout>
 <FrameLayout android:id="@+id/lgBoardHost" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="6dp" android:layout_marginBottom="6dp" android:background="@drawable/lazygarden_board" android:padding="6dp"/>
 <TextView android:id="@+id/lgGoals" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/lazygarden_panel" android:padding="8dp" android:textColor="#FFFFFF" android:textSize="13sp"/>
 <TextView android:id="@+id/lgBuildTask" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:background="@drawable/lazygarden_panel" android:padding="8dp" android:textColor="#F6E4A8" android:textSize="13sp" android:textStyle="bold"/>
 <Button android:id="@+id/lgAction" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Play" android:textAllCaps="false"/>
</LinearLayout>