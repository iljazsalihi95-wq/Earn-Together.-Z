 <FrameLayout android:id="@+id/lgBoardHost" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="6dp" android:layout_marginBottom="6dp" android:background="@drawable/lazygarden_board" android:padding="6dp"/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center" android:background="@drawable/lazygarden_panel" android:padding="6dp"><Button android:id="@+id/lgShuffle" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="🔀 Shuffle" android:textAllCaps="false" android:textStyle="bold"/><TextView android:id="@+id/lgBoosterHint" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:gravity="center" android:text="Booster • pa humbur lëvizje" android:textColor="#F6D36F" android:textSize="12sp"/></LinearLayout>
 <TextView android:id="@+id/lgGoals" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/lazygarden_panel" android:padding="8dp" android:textColor="#FFFFFF" android:textSize="13sp"/><TextView android:id="@+id/lgBuildTask" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:background="@drawable/lazygarden_panel" android:padding="8dp" android:textColor="#F6E4A8" android:textSize="13sp" android:textStyle="bold"/><Button android:id="@+id/lgAction" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Play" android:textAllCaps="false"/>
