<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient android:angle="0" android:startColor="#B889FF" android:endColor="#F0C75E" />
            <stroke android:width="1dp" android:color="#FFF0A8" />
            <padding android:left="10dp" android:top="8dp" android:right="10dp" android:bottom="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient android:angle="0" android:startColor="#7651E8" android:centerColor="#A968F0" android:endColor="#E3B84E" />
            <stroke android:width="1dp" android:color="#F6D36F" />
            <padding android:left="10dp" android:top="8dp" android:right="10dp" android:bottom="8dp" />
        </shape>
    </item>
</selector>